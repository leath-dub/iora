fun Slice(def T: type, is_const: bool = false) -> type {
    fun Data_Ptr(is_const: bool) -> type {
        // No need to pass `def T` to this function as definitions are globally
        // accessible
        //
        // We do need to pass 'is_const', however if you wanted to not need to
        // do that you could just mark that with `def` too.
        if is_const {
            return :*const T;
        }
        return :*T;
    }
    return :struct {
        // If we were passing a constant to `Data_Ptr` in a type context we
        // need to switch to a value context with '='
        // data: Data_Ptr(=true),
        data: Data_Ptr(is_const),
        len: u64,
    };
}

fun Field_Enum(def T: type, def loc = #here()) -> type {
    // a 'type' value is just an id, you need to call #type_info
    def info = #type_info(T);
    if def st: reflect.Struct = info {
        let alts: [st.size]str;
        for field[i] in st.fields {
            alts[i] = field.name;
        }
        return #to_type(reflect.Enum.of_alts(alts));
    } else {
        #compile_error(loc, "%. is not a struct", T);
    }
}
